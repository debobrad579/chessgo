{
  "name": "chessgo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:js": "NODE_ENV=production node esbuild.mjs",
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./dist/static/style.css --minify",
    "build": "npm run build:js && npm run build:css",
    "dev:js": "NODE_ENV=development node esbuild.mjs",
    "dev:css": "npx @tailwindcss/cli -i ./input.css -o ./static/style.css --minify --watch",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\""
  },
  "keywords": [],
