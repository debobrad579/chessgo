---
import Layout from "@/layouts/Layout.astro"
import { Button } from "@chessgo/ui/button"
---

<Layout>
  <div
    class="relative flex h-screen flex-1 flex-col items-center justify-center gap-4 px-4 py-24 text-center"
  >
    <img src="/logo.svg" alt="Logo" class="h-16 dark:invert" />
    <div class="font-medium text-muted-foreground">404 - Page Not Found</div>
    <div class="flex flex-wrap justify-center gap-3 pt-2">
      <a href="/">
        <Button size="lg">Return Home</Button>
      </a>
    </div>
  </div>
</Layout>
