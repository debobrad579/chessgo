import { Textarea } from "@chessgo/ui/textarea"
import { useChessGameContext } from "./ChessGameContext"
import { useEffect, useState } from "react"
import { useUser } from "@/context/UserContext"
import { ScrollArea } from "@chessgo/ui/scroll-area"

export function GameChat() {
  const user = useUser()
  const { chat, onSendMessage } = useChessGameContext()
  const [message, setMessage] = useState("")
  const [optimisticChat, setOptimisticChat] = useState(chat)

  useEffect(() => {
    setOptimisticChat(chat)
  }, [chat])

  return (
    <div className="flex h-full min-h-0 flex-col">
      <ScrollArea className="min-h-0 w-full flex-1">
        <div className="p-3">
          {optimisticChat?.map((message, i) => (
            <p key={i} className="break-words">
              [{message.user}]: {message.text}
            </p>
          ))}
        </div>
      </ScrollArea>
      <Textarea
        className="max-h-[4.85rem] resize-none overflow-hidden"
        placeholder="Send message"
        value={message}
        onChange={(e) => setMessage(e.target.value)}
        onKeyDown={(e) => {
          if (e.key !== "Enter") return

          e.preventDefault()

          if (onSendMessage != null && message !== "") {
            const text = message.trim()

            setOptimisticChat((prev) => [
              ...(prev ?? []),
              { user: user.name, text },
            ])

            onSendMessage(text)
            setMessage("")
          }
        }}
      />
    </div>
  )
}
