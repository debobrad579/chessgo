import { Popover, PopoverContent, PopoverTrigger } from "@chessgo/ui/popover"
import { Tooltip, TooltipContent, TooltipTrigger } from "@chessgo/ui/tooltip"
import { useState } from "react"
import { Button } from "@chessgo/ui/button"

export function ClaimWinButton({
  handleClaimWin,
  handleClaimDraw,
  disabled = false,
  hidden = false,
}: {
  handleClaimWin: () => void
  handleClaimDraw: () => void
  disabled?: boolean
  hidden?: boolean
}) {
  const [isPopoverOpen, setIsPopoverOpen] = useState(false)

  if (hidden) return

  return (
    <Tooltip>
      <Popover open={isPopoverOpen} onOpenChange={setIsPopoverOpen}>
        <TooltipTrigger asChild>
          <PopoverTrigger asChild>
            <Button
              className="text-2xl"
              size="icon"
              variant={drawOfferActive ? "default" : "ghost"}
              disabled={playerColor === pendingDrawOffer || disabled}
            >
              &frac12;
            </Button>
          </PopoverTrigger>
        </TooltipTrigger>
        <TooltipContent>
          {drawOfferActive ? "Accept draw" : "Offer draw"}
        </TooltipContent>
        <PopoverContent>
          <div className="space-y-2">
            <p>Claim</p>
            <div className="flex justify-center gap-2">
              <Button
                className="flex-1"
                variant="secondary"
                onClick={() => {
                  handleClaimDraw()
                  setIsPopoverOpen(false)
                }}
              >
                Claim Draw
              </Button>
              <Button
                className="flex-1"
                onClick={() => {
                  handleClaimWin()
                  setIsPopoverOpen(false)
                }}
              >
                Claim Win
              </Button>
            </div>
          </div>
        </PopoverContent>
      </Popover>
    </Tooltip>
  )
}
